	<!-- 远程闪避文字 -->
	<FamiliaMyth.TextMote_Dodge>闪避</FamiliaMyth.TextMote_Dodge>

	<!-- 遗迹探索·圣物匣描述模板（{0}=随机异教圣物名） -->
	<FM_AncientRelic_Description>{0}——古代仙精留下的强大宝物，虽然现在还暂时无法开启，但不能让其流入恶徒之手。交付给公会以完成委托。</FM_AncientRelic_Description>

	<!-- ==================== 美德触发时的眷族心声 ==================== -->
	<!-- 独白：不点破神存在的低声自语 -->
	<FamiliaMyth.Virtue.Whisper.Stalwart>还不能倒在这里……</FamiliaMyth.Virtue.Whisper.Stalwart>
	<FamiliaMyth.Virtue.Whisper.Courageous>我不怕。我不怕。</FamiliaMyth.Virtue.Whisper.Courageous>
	<FamiliaMyth.Virtue.Whisper.Focused>只看前面就好。</FamiliaMyth.Virtue.Whisper.Focused>
	<FamiliaMyth.Virtue.Whisper.Powerful>谁也别想过去。</FamiliaMyth.Virtue.Whisper.Powerful>
	<FamiliaMyth.Virtue.Whisper.Vigorous>我还站得住。</FamiliaMyth.Virtue.Whisper.Vigorous>

	<!-- 祷告：对神说的话 -->
	<FamiliaMyth.Virtue.Prayer.Stalwart>{god}，我还撑得住。</FamiliaMyth.Virtue.Prayer.Stalwart>
	<FamiliaMyth.Virtue.Prayer.Courageous>{god}，请驱散我的畏惧。</FamiliaMyth.Virtue.Prayer.Courageous>
	<FamiliaMyth.Virtue.Prayer.Focused>{god}啊，请为我指明前路。</FamiliaMyth.Virtue.Prayer.Focused>
	<FamiliaMyth.Virtue.Prayer.Powerful>{god}，我不会让他们过去。</FamiliaMyth.Virtue.Prayer.Powerful>
	<FamiliaMyth.Virtue.Prayer.Vigorous>{god}……我不会倒下。</FamiliaMyth.Virtue.Prayer.Vigorous>

	<!-- ==================== 恩惠丢失与重建 ==================== -->
	<!-- 恩惠载体 hediff 意外消失时的信件标题 -->
	<FamiliaMyth.PharnaLost.LetterLabel>恩惠消失</FamiliaMyth.PharnaLost.LetterLabel>
	<!-- 信件正文（{0}=殖民者名） -->
	<FamiliaMyth.PharnaLost.LetterText>你赋予{0}的神之恩惠已消失\n但恩惠内容仍保存在其灵魂深处，要重建恩惠吗？\n\n\n\n注：若非通过DevMode自行移除，请发送完整报错日志给本模组作者。</FamiliaMyth.PharnaLost.LetterText>
	<!-- 重建按钮：按记录重建恩惠 -->
	<FamiliaMyth.PharnaLost.Restore>重建</FamiliaMyth.PharnaLost.Restore>
	<!-- 重建成功提示（{0}=殖民者名） -->
	<FamiliaMyth.PharnaLost.RestoreDone>已为 {0} 重建恩惠</FamiliaMyth.PharnaLost.RestoreDone>
	<!-- 重建失败理由：无法创建恩惠 -->
	<FamiliaMyth.PharnaLost.RestoreFailed>重建失败：无法创建恩惠</FamiliaMyth.PharnaLost.RestoreFailed>
	<!-- 重建失败理由：该殖民者已持有恩惠 -->
	<FamiliaMyth.PharnaLost.AlreadyRestored>该殖民者已持有恩惠</FamiliaMyth.PharnaLost.AlreadyRestored>
	<!-- 放弃按钮：丢弃记录，不再提示 -->
	<FamiliaMyth.PharnaLost.Discard>放弃</FamiliaMyth.PharnaLost.Discard>

