	<!-- 赋予恩惠仪式完成后的信件描述文本 -->
	<FamiliaMyth.GrantPharnaRitualDone>{god} 向 {pawn} 降下了神之恩惠。现在 {pawn} 是 {god} 眷族的一员了。</FamiliaMyth.GrantPharnaRitualDone>

	<!-- 升华仪式完成后追加的描述文本：升华只恢复铭刻机会，铭刻本身保留 -->
	<FamiliaMyth.InscriptionRenewed>{god} 给予 {pawn} 的恩惠得到了升华，可以再次为 {pawn} 选择铭刻的方向了。</FamiliaMyth.InscriptionRenewed>

	<!-- 升华完成但已无任何可授予奖励时的提示文本（{0}=接受者名） -->
	<FamiliaMyth.AscendNoReward>{0} 的升华没有换来新的恩赐——已经没有可以授予的奖励了。</FamiliaMyth.AscendNoReward>

	<!-- 拒绝理由：该殖民者已拥有恩惠，无法再次赋予 -->
	<FamiliaMyth.AlreadyHavePharnaRefusion>已有恩惠</FamiliaMyth.AlreadyHavePharnaRefusion>
	<!-- 拒绝理由：该殖民者没有恩惠，无法升华 -->
	<FamiliaMyth.HaveNoPharnaRefusion>没有恩惠</FamiliaMyth.HaveNoPharnaRefusion>
	<!-- 拒绝理由：该殖民者未满足升华条件（能力≥D且有一件合格伟业） -->
	<FamiliaMyth.NotMeetAscendRequirementRefusion>未达成足够的伟业或基础能力值不足</FamiliaMyth.NotMeetAscendRequirementRefusion>
	<!-- 拒绝理由：该殖民者恩惠等级已达上限，无法继续升华 -->
	<FamiliaMyth.MaxLevelRefusion>恩惠等级已达上限</FamiliaMyth.MaxLevelRefusion>
	<!-- 拒绝理由：该殖民者不属于玩家当前文化，不能担任恩惠仪式的接受者 -->
	<FamiliaMyth.NotFamiliaMemberRefusion>非本眷族成员</FamiliaMyth.NotFamiliaMemberRefusion>
	
	<!-- 经验值 -->
	<FamiliaMyth.Experience>经验值</FamiliaMyth.Experience>

