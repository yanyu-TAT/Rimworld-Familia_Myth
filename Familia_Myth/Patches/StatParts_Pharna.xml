<Patch>

    <!-- ============================================================ -->
    <!-- Familia Myth - StatPart 注入补丁                              -->
    <!-- 将 StatPart_Pharna 注入原版 StatDef 的 <parts> 列表           -->
    <!-- k = 当前能力值 + 潜在值                                       -->
    <!-- Offset:   val += k * a                                        -->
    <!-- Factor:   val *= (1 + k * a)                                  -->
    <!-- ExpDecay: val *= a ^ k                                        -->
    <!--                                                              -->
    <!-- 重构说明：改用 PatchOperationConditional 模式，参考           -->
    <!-- IsekaiLeveling 的 IsekaiStatPatches.xml 实现。                -->
    <!-- match: <parts> 已存在时追加 StatPart                          -->
    <!-- nomatch: <parts> 不存在时创建并同时注入 StatPart              -->
    <!-- ============================================================ -->


    <!-- ==================== 力量 (Strength) ======================= -->

    <!-- 近战伤害系数: val += k * 0.00075 -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/StatDef[defName="MeleeDamageFactor"]/parts</xpath>
        <match Class="PatchOperationAdd">
            <xpath>Defs/StatDef[defName="MeleeDamageFactor"]/parts</xpath>
            <value>
                <li Class="FamiliaMyth.Pharna.StatPart_Pharna">
                    <statusType>Strength</statusType>
                    <mode>Offset</mode>
                    <a>0.00075</a>
                </li>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/StatDef[defName="MeleeDamageFactor"]</xpath>
            <value>
                <parts>
                    <li Class="FamiliaMyth.Pharna.StatPart_Pharna">
                        <statusType>Strength</statusType>
                        <mode>Offset</mode>
                        <a>0.00075</a>
                    </li>
                </parts>
            </value>
        </nomatch>
    </Operation>
    <!-- 狂化招乱：受伤越重，近战伤害越高（parts 已由上方保证存在） -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/StatDef[defName="MeleeDamageFactor"]/parts</xpath>
        <value>
            <li Class="FamiliaMyth.Abilities.StatPart_BerserkerChaos" />
        </value>
    </Operation>

