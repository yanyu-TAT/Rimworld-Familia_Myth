<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <!-- ============================================================ -->
    <!-- Familia Myth - StatPart 注入补丁                              -->
    <!-- 将 StatPart_Pharna 注入原版 StatDef 的 <parts> 列表           -->
    <!-- k = 当前能力值 + 潜在值                                       -->
    <!-- Offset:   val += k * a                                        -->
    <!-- Factor:   val *= (1 + k * a)                                  -->
    <!-- ExpDecay: val *= a ^ k                                        -->
    <!-- ============================================================ -->


    <!-- ==================== 力量 (Strength) ======================= -->

    <!-- 近战伤害系数: val += k * 0.00075 -->
    <Operation Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
            <li Class="PatchOperationTest">
                <xpath>Defs/StatDef[defName="MeleeDamageFactor"]/parts</xpath>
                <success>Invert</success>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/StatDef[defName="MeleeDamageFactor"]</xpath>
                <value><parts /></value>
            </li>
        </operations>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/StatDef[defName="MeleeDamageFactor"]/parts</xpath>
        <value>
            <li Class="FamiliaMyth.Pharna.StatPart_Pharna">
                <statusType>Strength</statusType>
                <mode>Offset</mode>
                <a>0.00075</a>
            </li>
        </value>
    </Operation>

    <!-- 负重能力: val *= (1 + k * 0.00050) -->
