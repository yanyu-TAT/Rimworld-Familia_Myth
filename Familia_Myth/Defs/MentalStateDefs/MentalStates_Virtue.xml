<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- =============================================================== -->
  <!-- 美德精神状态定义                                                -->
  <!-- 由 Patch_MentalBreaker 在崩溃前随机触发，                          -->
  <!-- 持续 1~2 天（由 MentalState_Virtue.PostStart 设置 forceRecoverAfterTicks）。 -->
  <!-- stateClass 使用命名空间前缀 FamiliaMyth.Pharna                   -->
  <!-- =============================================================== -->

  <MentalStateDef Name="VirtueMentalStateBase" Abstract="True">
    <stateClass>FamiliaMyth.Pharna.MentalState_Virtue</stateClass>
    <category>Misc</category>
    <!-- 实际持续时间由 PostStart 的 forceRecoverAfterTicks（1~2天）决定，此处在避免随机恢复 -->
    <minTicksBeforeRecovery>1</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>999999</maxTicksBeforeRecovery>
    <recoveryMtbDays>999</recoveryMtbDays>
    <nameColor>(0.3, 0.9, 0.7)</nameColor>
    <beginLetterDef>PositiveEvent</beginLetterDef>
    <inCaravanCanDo>true</inCaravanCanDo>
    <recoverFromSleep>true</recoverFromSleep>
  </MentalStateDef>

  <MentalStateDef ParentName="VirtueMentalStateBase">
    <defName>MentalState_Virtue_Stalwart</defName>
    <label>坚定</label>
    <beginLetterLabel>美德：坚定</beginLetterLabel>
    <beginLetter>{0}的意志受到考验：[PAWN_pronoun]咬紧牙关，把快要折断的东西重新撑了起来</beginLetter>
    <recoveryMessage>{0}已经恢复了</recoveryMessage>
    <baseInspectLine>美德：坚定</baseInspectLine>
  </MentalStateDef>

  <MentalStateDef ParentName="VirtueMentalStateBase">
    <defName>MentalState_Virtue_Courageous</defName>
    <label>无畏</label>
    <beginLetterLabel>美德：无畏</beginLetterLabel>
    <beginLetter>{0}的恐惧被驱散了：想起自己为何站在这里，[PAWN_pronoun]便不再退却</beginLetter>
    <recoveryMessage>{0}已经恢复了</recoveryMessage>
    <baseInspectLine>美德：无畏</baseInspectLine>
  </MentalStateDef>

  <MentalStateDef ParentName="VirtueMentalStateBase">
    <defName>MentalState_Virtue_Focused</defName>
    <label>专注</label>
    <beginLetterLabel>美德：专注</beginLetterLabel>
    <beginLetter>{0}的思绪不再迷惘：杂念尽数落下，[PAWN_pronoun]眼中只剩下该做的事</beginLetter>
    <recoveryMessage>{0}已经恢复了</recoveryMessage>
    <baseInspectLine>美德：专注</baseInspectLine>
  </MentalStateDef>

  <MentalStateDef ParentName="VirtueMentalStateBase">
    <defName>MentalState_Virtue_Powerful</defName>
    <label>勇猛</label>
    <beginLetterLabel>美德：勇猛</beginLetterLabel>
    <beginLetter>{0}的战意已经点燃：此刻[PAWN_pronoun]确信，身后的东西无人能够碰触</beginLetter>
    <recoveryMessage>{0}已经恢复了</recoveryMessage>
    <baseInspectLine>美德：勇猛</baseInspectLine>
  </MentalStateDef>

  <MentalStateDef ParentName="VirtueMentalStateBase">
    <defName>MentalState_Virtue_Vigorous</defName>
    <label>振奋</label>
    <beginLetterLabel>美德：振奋</beginLetterLabel>
    <beginLetter>{0}重新振作了起来：[PAWN_pronoun]抬起头，发觉自己并不是一个人</beginLetter>
    <recoveryMessage>{0}已经恢复了</recoveryMessage>
    <baseInspectLine>美德：振奋</baseInspectLine>
  </MentalStateDef>

</Defs>