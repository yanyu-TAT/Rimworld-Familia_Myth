<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 玩家可见文本可经 Languages/<语言>/DefInjected/FeatTraitDef/FeatTraits.xml 覆盖（此处为默认文本，同时作为兜底） -->
  <!-- judgerClass 指向判定器：阈值写在各判定器类内（Source/FeatTraitJudgers.cs），此处只配系数与排序 -->

  <FamiliaMyth.Feat.FeatTraitDef>
    <defName>FeatTrait_RepelledAssault</defName>
    <label>击退强袭</label>
    <description>击退了一支成规模的来袭之敌。</description>
    <multiplier>1.2</multiplier>
    <judgerClass>FamiliaMyth.Feat.Judger_RepelledAssault</judgerClass>
    <displayOrder>10</displayOrder>
  </FamiliaMyth.Feat.FeatTraitDef>

  <FamiliaMyth.Feat.FeatTraitDef>
    <defName>FeatTrait_AgainstTheOdds</defName>
    <label>以寡敌众</label>
    <description>以远少于对方的人数击退了强敌。</description>
    <multiplier>1.4</multiplier>
    <judgerClass>FamiliaMyth.Feat.Judger_AgainstTheOdds</judgerClass>
    <displayOrder>20</displayOrder>
  </FamiliaMyth.Feat.FeatTraitDef>

  <FamiliaMyth.Feat.FeatTraitDef>
    <defName>FeatTrait_FlawlessVictory</defName>
    <label>无伤克敌</label>
    <description>自身无人倒下便结束了这场战斗。</description>
    <multiplier>1.3</multiplier>
    <judgerClass>FamiliaMyth.Feat.Judger_FlawlessVictory</judgerClass>
    <displayOrder>30</displayOrder>
  </FamiliaMyth.Feat.FeatTraitDef>

  <FamiliaMyth.Feat.FeatTraitDef>
    <defName>FeatTrait_SlayTheMighty</defName>
    <label>绝境克强敌</label>
    <description>在压倒性的劣势中击杀强敌。</description>
    <multiplier>1.6</multiplier>
    <judgerClass>FamiliaMyth.Feat.Judger_SlayTheMighty</judgerClass>
    <displayOrder>40</displayOrder>
  </FamiliaMyth.Feat.FeatTraitDef>

</Defs>
