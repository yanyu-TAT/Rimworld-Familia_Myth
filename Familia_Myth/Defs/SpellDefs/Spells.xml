<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- ==================== 诺亚治愈 (Noah Heal) ===================== -->
    <FamiliaMyth.Abilities.SpellDef>
        <defName>Spell_NoahHeal</defName>
        <label>诺亚治愈</label>
        <description>包扎所有伤口在一段时间内加速愈合</description>

        <!-- 魔法实现类 -->
        <spellClass>FamiliaMyth.Abilities.Spell_NoahHeal</spellClass>

        <!-- 稀有度 -->
        <rarity>Uncommon</rarity>

        <!-- 魔法类型：治疗魔法 -->
        <spellType>Heal</spellType>

        <!-- 代表色：绿色 -->
        <themeColor>(0.3, 0.8, 0.35, 1)</themeColor>

        <!-- 图标路径 -->
        <iconPath>Familia_Myth/UI/Icons/Spells/NoahHeal</iconPath>

        <!-- 显示与施法设置：贴身释放 -->
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
        <jobDef>CastAbilityOnThingMelee</jobDef>
        <stunTargetWhileCasting>true</stunTargetWhileCasting>

        <!-- 动词属性：近战接触，咏唱2秒 -->
        <verbProperties>
            <verbClass>RimWorld.Verb_CastAbilityTouch</verbClass>
            <range>-1</range>
            <warmupTime>4</warmupTime>
            <drawAimPie>false</drawAimPie>
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
                <canTargetSelf>false</canTargetSelf>
                <canTargetAnimals>false</canTargetAnimals>
            </targetParams>
        </verbProperties>

        <!-- 技能效果组件 -->
        <comps>
            <li Class="FamiliaMyth.Abilities.CompProperties_NoahHeal" />
        </comps>

        <!-- 咏唱文本 -->
        <incantationLines>
            <li>此刻幽远森林之歌</li>
            <li>往昔生命之曲</li>
            <li>请向有求于汝之人</li>
			<li>降下治愈之慈悲</li>
			<li>「诺亚治愈」</li>
        </incantationLines>
    </FamiliaMyth.Abilities.SpellDef>

	<!-- ==================== 光明之风 (Luminous Wind) ===================== -->
	<FamiliaMyth.Abilities.SpellDef>
		<defName>Spell_LuminousWind</defName>
		<label>光明之风</label>
		<description>咏唱过程中召唤数个风弹，结束时自动追踪附近敌人</description>

		<!-- 魔法实现类 -->
		<spellClass>FamiliaMyth.Abilities.Spell_LuminousWind</spellClass>

		<!-- 稀有度 -->
		<rarity>Uncommon</rarity>

		<!-- 魔法类型：攻击魔法 -->
		<spellType>Attack</spellType>

		<!-- 代表色：浅绿色 -->
		<themeColor>(0.55, 0.95, 0.6, 1)</themeColor>

		<!-- 图标路径 -->
		<iconPath>Familia_Myth/UI/Icons/Spells/LuminousWind</iconPath>

		<!-- 显示与施法设置：自身释放 -->
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>

		<!-- 动词属性：自身施法（warmupTime由代码根据咏唱行数计算覆盖） -->
		<verbProperties>
			<verbClass>RimWorld.Verb_CastAbility</verbClass>
			<targetable>false</targetable>
			<nonInterruptingSelfCast>true</nonInterruptingSelfCast>
			<range>-1</range>
			<warmupTime>1</warmupTime>
			<drawAimPie>false</drawAimPie>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
			</targetParams>
		</verbProperties>

		<!-- 咏唱文本 -->
		<incantationLines>
			<li>如今远去的森林穹苍</li>
			<li>无穷夜天镶嵌的无限星斗</li>
			<li>回应愚昧如我的声音</li>
			<li>再度赐我星火加护</li>
			<li>予弃汝而去者光明慈悲</li>
			<li>来吧，漂泊的风，流浪的旅人</li>
			<li>飞越天空，奔驰荒野</li>
			<li>以胜过万物的速度疾行</li>
			<li>蕴含群星光辉征讨敌人</li>
			<li>「光明之风」</li>
		</incantationLines>
		<lineInterval>1</lineInterval>

		<!-- 引爆咒 -->
		<hasSpellKey>true</hasSpellKey>
		<spellKey>「Luvia」</spellKey>
		<spellKeyDescription>引爆所有风弹，造成范围伤害</spellKeyDescription>
	</FamiliaMyth.Abilities.SpellDef>

	<!-- ==================== 齐射火标枪 (Fusillade Flame Spears) ===================== -->
	<FamiliaMyth.Abilities.SpellDef>
		<defName>Spell_FusilladeFlameSpears</defName>
		<label>齐射火标枪</label>
		<description>咏唱过程中锁定扇形范围内敌人，结束时发射火标枪轰炸目标附近区域</description>

		<!-- 魔法实现类 -->
		<spellClass>FamiliaMyth.Abilities.Spell_FusilladeFlameSpears</spellClass>

		<!-- 稀有度 -->
		<rarity>Rare</rarity>

		<!-- 魔法类型：攻击魔法 -->
		<spellType>Attack</spellType>

		<!-- 代表色：红色 -->
		<themeColor>(1, 0.25, 0.2, 1)</themeColor>

		<!-- 图标路径 -->
		<iconPath>Familia_Myth/UI/Icons/Spells/FusilladeFlameSpears</iconPath>

		<!-- 显示与施法设置 -->
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>

		<!-- 动词属性 -->
		<verbProperties>
			<verbClass>FamiliaMyth.Abilities.Verb_CastAbility_FanTarget</verbClass>
			<range>60</range>
			<warmupTime>3</warmupTime>
			<drawAimPie>false</drawAimPie>
			<targetParams>
				<canTargetPawns>true</canTargetPawns>
				<canTargetLocations>true</canTargetLocations>
				<canTargetSelf>false</canTargetSelf>
				<canTargetAnimals>true</canTargetAnimals>
				<canTargetBuildings>true</canTargetBuildings>
			</targetParams>
		</verbProperties>

		<!-- 咏唱文本 -->
		<incantationLines>
			<li>高傲的战士们</li>
			<li>森林的射手们</li>
			<li>进逼的掠夺者在前</li>
			<li>拿起你们的弓</li>
			<li>回应同胞的声音</li>
			<li>搭箭上弦点起烈焰</li>
			<li>森林的灯火——</li>
			<li>命你放箭，精灵的火矢</li>
			<li>如雨骤降，火烧蛮族</li>
			<li>「齐射火标枪」</li>
		</incantationLines>
		<lineInterval>1</lineInterval>
	</FamiliaMyth.Abilities.SpellDef>

	<!-- ==================== 灵弓光箭 (Arcs Ray) ===================== -->
	<FamiliaMyth.Abilities.SpellDef>
		<defName>Spell_ArcsRay</defName>
		<label>灵弓光箭</label>
		<description>咏唱时凝聚一支必中的光箭，结束时发射追踪选定的敌人，贯穿路径上的敌人和建筑直到命中（无视护甲与承伤系数）；咏唱引爆咒可立即引爆光箭，造成范围眩晕和伤害。</description>

		<!-- 魔法实现类 -->
		<spellClass>FamiliaMyth.Abilities.Spell_ArcsRay</spellClass>

		<!-- 稀有度 -->
		<rarity>Uncommon</rarity>

		<!-- 魔法类型：攻击魔法 -->
		<spellType>Attack</spellType>

		<!-- 代表色：浅银色 -->
		<themeColor>(0.8, 0.82, 0.88, 1)</themeColor>

		<!-- 图标路径 -->
		<iconPath>Familia_Myth/UI/Icons/Spells/ArcsRay</iconPath>

		<!-- 显示与施法设置 -->
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>

		<!-- 动词属性：目标化施法（Warmup 由咏唱行数计算） -->
		<verbProperties>
			<verbClass>RimWorld.Verb_CastAbility</verbClass>
			<range>75</range>
			<warmupTime>3</warmupTime>
			<drawAimPie>false</drawAimPie>
			<targetParams>
				<canTargetPawns>true</canTargetPawns>
				<canTargetLocations>true</canTargetLocations>
				<canTargetSelf>false</canTargetSelf>
				<canTargetAnimals>true</canTargetAnimals>
				<validator>FamiliaMyth.Abilities.Spell_ArcsRay.CanTarget</validator>
			</targetParams>
			<requireLineOfSight>false</requireLineOfSight>
		</verbProperties>

		<!-- 咏唱文本 -->
		<incantationLines>
			<li>解放的光箭</li>
			<li>圣木的弓干</li>
			<li>吾为弓之名手</li>
			<li>挽弓搭箭吧</li>
			<li>妖精的射手</li>
			<li>贯穿吧，必中之矢</li>
			<li>「灵弓光箭」</li>
		</incantationLines>
		<lineInterval>1</lineInterval>

		<!-- 引爆咒 -->
		<hasSpellKey>true</hasSpellKey>
		<spellKey>「光华」</spellKey>
		<spellKeyDescription>引爆光箭，造成范围眩晕和伤害</spellKeyDescription>
	</FamiliaMyth.Abilities.SpellDef>

	<!-- ==================== The World ===================== -->
	<FamiliaMyth.Abilities.SpellDef>
		<defName>Spell_TheWorld</defName>
		<label>The World</label>
		<description>展开时滞领域，范围内除发动者以外的事物的时间将被停止。</description>

		<!-- 魔法实现类 -->
		<spellClass>FamiliaMyth.Abilities.Spell_TheWorld</spellClass>

		<!-- 稀有度 -->
		<rarity>Rare</rarity>

		<!-- 魔法类型：领域魔法 -->
		<spellType>Field</spellType>

		<!-- 代表色：偏深蓝的银色 -->
		<themeColor>(0.6, 0.65, 0.78, 1)</themeColor>

		<magicCircles>
			<li>
				<texPath>Familia_Myth/Things/Mote/MagicCircles/TheWorld1</texPath>
				<size>(24,24)</size>
				<scaleFrom>0.5</scaleFrom>
				<drawColor>(1,1,1,0.6)</drawColor>
			</li>
			<li>
				<texPath>Familia_Myth/Things/Mote/MagicCircles/TheWorld2</texPath>
				<size>(24,24)</size>
				<rotate>5.0</rotate>
				<altitude>0.01</altitude>
				<drawColor>(1,1,1,0.6)</drawColor>
			</li>
			<li>
				<texPath>Familia_Myth/Things/Mote/MagicCircles/TheWorld3</texPath>
				<size>(24,24)</size>
				<altitude>0.02</altitude>
				<drawColor>(1,1,1,0.6)</drawColor>
			</li>
		</magicCircles>

		<!-- 图标路径 -->
		<iconPath>Familia_Myth/UI/Icons/Spells/TheWorld</iconPath>

		<!-- 显示与施法设置 -->
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>

		<!-- 动词属性：自身施法 -->
		<verbProperties>
			<verbClass>RimWorld.Verb_CastAbility</verbClass>
			<targetable>false</targetable>
			<nonInterruptingSelfCast>true</nonInterruptingSelfCast>
			<range>-1</range>
			<warmupTime>1</warmupTime>
			<drawAimPie>false</drawAimPie>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
			</targetParams>
		</verbProperties>

		<!-- 咏唱文本 -->
		<incantationLines>
			<li>月之时计指向终点</li>
			<li>万物喧嚣就此落幕</li>
			<li>屏息凝神，万众瞩目</li>
			<li>好了，别眨眼——</li>
			<li>完美而潇洒的舞台即将揭晓</li>
			<li>「The World」</li>
		</incantationLines>
		<lineInterval>1.2</lineInterval>

		<!-- 引爆咒 -->
		<hasSpellKey>true</hasSpellKey>
		<spellKey>「时间开始流动」</spellKey>
		<spellKeyDescription>立刻结束时停，根据剩余时间回复精神力和降低心灵熵</spellKeyDescription>
	</FamiliaMyth.Abilities.SpellDef>
</Defs>