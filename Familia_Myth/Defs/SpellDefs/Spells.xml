		<!-- 以自身为中心展开，无需选择目标 -->
		<targetRequired>false</targetRequired>

		<!-- 代表色：紫 -->
		<themeColor>(0.55, 0.25, 0.95, 1)</themeColor>

		<!-- 图标路径：占位用君王之剑，待绘布都御魂图标 -->
		<iconPath>Familia_Myth/UI/Icons/Spells/FutsuNoMitama</iconPath>

		<!-- 动词属性：以自身为中心 -->
