<Defs>

    <!-- ==================== 诺亚治愈 (Noah Heal) ===================== -->
    <FamiliaMyth.Abilities.SpellDef>
        <defName>Spell_NoahHeal</defName>
		<manaCost>25</manaCost>
		<statBases>
			<Ability_EntropyGain>45</Ability_EntropyGain>
		</statBases>
        <label>诺亚治愈</label>
        <description>包扎所有伤口在一段时间内加速愈合</description>

        <!-- 魔法实现类 -->
        <spellClass>FamiliaMyth.Abilities.Spell_NoahHeal</spellClass>

        <!-- 稀有度 -->
        <rarity>Common</rarity>

        <!-- 魔法类型：治疗魔法 -->
        <spellType>Heal</spellType>

        <!-- 代表色：绿色 -->
        <themeColor>(0.3, 0.8, 0.35, 1)</themeColor>

        <!-- 图标路径 -->
        <iconPath>Familia_Myth/UI/Icons/Spells/NoahHeal</iconPath>

        <!-- 显示与施法设置：贴身释放 -->
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
        <jobDef>CastAbilityOnThingMelee</jobDef>
        <stunTargetWhileCasting>true</stunTargetWhileCasting>

        <!-- 动词属性：近战接触-->
        <verbProperties>
            <verbClass>FamiliaMyth.Abilities.Verb_CastSpell_Touch</verbClass>
            <range>-1</range>
            <warmupTime>4</warmupTime>	<!-- warmupTime完全由def自身根据咏唱词行数和间隔计算-->
            <drawAimPie>false</drawAimPie>
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
                <canTargetSelf>false</canTargetSelf>
                <canTargetAnimals>false</canTargetAnimals>
            </targetParams>
        </verbProperties>

        <!-- 咏唱文本 -->
        <incantationLines>
            <li>此刻幽远森林之歌</li>
            <li>往昔生命之曲</li>
            <li>请向有求于汝之人</li>
			<li>降下治愈之慈悲</li>
			<li>「诺亚治愈」</li>
        </incantationLines>
		<lineInterval>2.2</lineInterval>
    </FamiliaMyth.Abilities.SpellDef>

	<!-- ==================== 光明之风 (Luminous Wind) ===================== -->
	<FamiliaMyth.Abilities.SpellDef>
		<defName>Spell_LuminousWind</defName>
		<manaCost>100</manaCost>
		<statBases>
			<Ability_EntropyGain>30</Ability_EntropyGain>
		</statBases>
		<label>光明之风</label>
		<description>咏唱过程中召唤数个风弹，结束时自动追踪附近敌人</description>

		<!-- 魔法实现类 -->
		<spellClass>FamiliaMyth.Abilities.Spell_LuminousWind</spellClass>

		<!-- 稀有度 -->
		<rarity>Uncommon</rarity>

		<!-- 魔法类型：攻击魔法 -->
		<spellType>Attack</spellType>

		<!-- 代表色：浅绿色 -->
		<themeColor>(0.55, 0.95, 0.6, 1)</themeColor>

		<!-- 图标路径 -->
		<iconPath>Familia_Myth/UI/Icons/Spells/LuminousWind</iconPath>

		<!-- 显示与施法设置：自身释放 -->
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>

		<!-- 动词属性：自身施法（warmupTime由代码根据咏唱行数计算覆盖） -->
		<verbProperties>
			<verbClass>FamiliaMyth.Abilities.Verb_CastSpell</verbClass>
			<targetable>false</targetable>
			<nonInterruptingSelfCast>true</nonInterruptingSelfCast>
			<range>-1</range>
			<warmupTime>1</warmupTime>
			<drawAimPie>false</drawAimPie>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
			</targetParams>
		</verbProperties>

		<!-- 咏唱文本 -->
		<incantationLines>
			<li>如今远去的森林穹苍</li>
			<li>无穷夜天镶嵌的无限星斗</li>
			<li>回应愚昧如我的声音</li>
			<li>再度赐我星火加护</li>
			<li>予弃汝而去者光明慈悲</li>
			<li>来吧，漂泊的风，流浪的旅人</li>
			<li>飞越天空，奔驰荒野</li>
			<li>以胜过万物的速度疾行</li>
			<li>蕴含群星光辉征讨敌人</li>
			<li>「光明之风」</li>
		</incantationLines>
		<lineInterval>2.1</lineInterval>

		<!-- 引爆咒 -->
		<hasSpellKey>true</hasSpellKey>
		<spellKey>「Luvia」</spellKey>
		<spellKeyDescription>引爆所有风弹，造成范围伤害</spellKeyDescription>
	</FamiliaMyth.Abilities.SpellDef>

