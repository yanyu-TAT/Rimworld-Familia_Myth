		<magicCircles>
			<li>
				<texPath>Familia_Myth/Things/Mote/MagicCircles/2</texPath>
				<drawColor>(0.55, 0.25, 0.95, 1)</drawColor>
				<size>(6, 6)</size>
				<scaleFrom>0.5</scaleFrom>
				<rotate>10</rotate>
				<appearProgress>0</appearProgress>
