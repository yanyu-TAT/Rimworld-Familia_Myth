<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ==================== 风弹 (Wind Missile) ===================== -->
	<ThingDef ParentName="BaseBullet">
		<defName>Projectile_WindMissile</defName>
		<label>风弹</label>
		<description>光明之风生成的风弹，可追踪敌人或引爆造成范围伤害</description>

		<thingClass>FamiliaMyth.Abilities.Projectile_WindMissile</thingClass>

		<graphicData>
			<texPath>Familia_Myth/Things/Projectile/WindMissile</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.0</drawSize>
		</graphicData>

		<projectile>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>10</damageAmountBase>
			<armorPenetrationBase>2</armorPenetrationBase>
			<stoppingPower>10</stoppingPower>
			<speed>60</speed>
			<flyOverhead>false</flyOverhead>
			<alwaysFreeIntercept>true</alwaysFreeIntercept>
		</projectile>
	</ThingDef>

	<!-- ==================== 光箭 (Arcs Ray) ===================== -->
	<ThingDef ParentName="BaseBullet">
		<defName>Projectile_ArcsRay</defName>
		<label>光箭</label>
		<description>光箭魔法凝聚的贯穿之矢，可追踪目标并穿透路径上的敌人与建筑</description>

		<thingClass>FamiliaMyth.Abilities.Projectile_ArcsRay</thingClass>

		<graphicData>
			<texPath>Familia_Myth/Things/Projectile/ArcsRay</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>2.5</drawSize>
		</graphicData>

		<projectile>
			<damageDef>LightArrow</damageDef>
			<damageAmountBase>50</damageAmountBase>
			<armorPenetrationBase>0</armorPenetrationBase>
			<stoppingPower>10</stoppingPower>
			<speed>60</speed>
			<flyOverhead>false</flyOverhead>
			<alwaysFreeIntercept>true</alwaysFreeIntercept>
		</projectile>
	</ThingDef>

	<!-- ==================== 君王之剑 (Kings Sword) ===================== -->
	<ThingDef ParentName="BaseBullet">
		<defName>Projectile_KingsSword</defName>
		<label>君王之剑</label>
		<description>君王之剑魔法召唤的环绕悬浮巨剑，自动攻击施法者周围的敌人</description>

		<thingClass>FamiliaMyth.Abilities.Projectile_KingsSword</thingClass>

		<graphicData>
			<texPath>Familia_Myth/Things/Projectile/KingsSword</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>KingsSword</shaderType>
			<!-- drawSize = 2.5 × (512 / 213) ≈ 6.01：使中心→剑尖(213px)映射到 2.5 世界单位，与基础攻击范围 BasicAttackRange=2.5 对齐 -->
			<drawSize>(6.01, 6.01)</drawSize>
		</graphicData>

		<projectile>
			<damageDef>Cut</damageDef>
			<damageAmountBase>20</damageAmountBase>
			<armorPenetrationBase>0.6</armorPenetrationBase>
			<stoppingPower>10</stoppingPower>
			<speed>60</speed>
			<flyOverhead>true</flyOverhead>
			<alwaysFreeIntercept>false</alwaysFreeIntercept>
		</projectile>
	</ThingDef>

</Defs>