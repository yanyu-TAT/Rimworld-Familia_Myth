<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="MoteBase">
		<defName>MagicMissileBurst</defName>
		<thingClass>MoteThrown</thingClass>
		<graphicData>
			<texPath>Things/Mote/ExplosionFlash</texPath>
			<shaderType>MoteGlow</shaderType>
			<color>(1, 1, 1, 1)</color>
		</graphicData>
		<mote>
			<fadeInTime>0.05</fadeInTime>
			<solidTime>0.2</solidTime>
			<fadeOutTime>0.5</fadeOutTime>
			<growthRate>30</growthRate>
		</mote>
	</ThingDef>

	<FleckDef>
		<defName>MagicMissileTrail</defName>
		<fleckSystemClass>Verse.FleckSystemThrown</fleckSystemClass>
		<altitudeLayer>Projectile</altitudeLayer>
		<graphicData>
			<graphicClass>Graphic_FleckPulse</graphicClass>
			<texPath>Familia_Myth/Things/Mote/LineTrail</texPath>
			<shaderType>MoteGlow</shaderType>
			<color>(1, 1, 1, 1)</color>
			<drawSize>(0.1, 1.2)</drawSize>
		</graphicData>
		<fadeInTime>0.02</fadeInTime>
		<solidTime>0.05</solidTime>
		<fadeOutTime>0.35</fadeOutTime>
		<growthRate>0.5</growthRate>
		<rotateTowardsMoveDirection>true</rotateTowardsMoveDirection>
	</FleckDef>

	<FleckDef>
		<defName>LineIndicator</defName>
		<fleckSystemClass>FleckSystemStatic</fleckSystemClass>
		<graphicData>
			<graphicClass>Graphic_Fleck</graphicClass>
			<texPath>Familia_Myth/Things/Mote/LineSolid</texPath>
			<shaderType>MoteGlow</shaderType>
			<color>(1, 1, 1, 1)</color>
		</graphicData>
		<fadeInTime>0</fadeInTime>
		<solidTime>0.05</solidTime>
		<fadeOutTime>0</fadeOutTime>
	</FleckDef>

	<FleckDef>
		<defName>SwordRainImpact</defName>
		<fleckSystemClass>FleckSystemStatic</fleckSystemClass>
		<graphicData>
			<graphicClass>Graphic_Fleck</graphicClass>
			<texPath>Things/Mote/ExplosionFlash</texPath>
			<shaderType>MoteGlow</shaderType>
			<color>(0.85, 0.95, 1, 1)</color>
		</graphicData>
		<fadeInTime>0</fadeInTime>
		<solidTime>0.3</solidTime>
		<fadeOutTime>1</fadeOutTime>
	</FleckDef>

	<ThingDef ParentName="MoteBase">
		<defName>Mote_TargetLock</defName>
		<thingClass>FamiliaMyth.Abilities.Mote_TargetLock</thingClass>
		<graphicData>
			<texPath>Familia_Myth/Things/Mote/TargetLock</texPath>
			<shaderType>MoteGlow</shaderType>
			<color>(1, 1, 1, 1)</color>
		</graphicData>
		<mote>
			<fadeInTime>0.5</fadeInTime>
			<solidTime>999999</solidTime>
			<fadeOutTime>0.2</fadeOutTime>
		</mote>
	</ThingDef>

	<FleckDef>
		<defName>ArcsRayChargeSpark</defName>
		<fleckSystemClass>Verse.FleckSystemThrown</fleckSystemClass>
		<altitudeLayer>Projectile</altitudeLayer>
		<graphicData>
			<graphicClass>Graphic_Fleck</graphicClass>
			<texPath>Familia_Myth/Things/Mote/ChargeSpark</texPath>
			<shaderType>MoteGlow</shaderType>
			<color>(1, 1, 1, 1)</color>
			<drawSize>(0.2, 0.2)</drawSize>
		</graphicData>
		<fadeInTime>0.05</fadeInTime>
		<solidTime>0.05</solidTime>
		<fadeOutTime>0.4</fadeOutTime>
	</FleckDef>

	<!-- 居合拔刀气刃斩 - 格挡火花：Patch_IaiSpiritSlash 吸收伤害时生成，
	     通过 velocity 随机方向迸溅，instanceColor 红色覆写颜色。
	     必须为 FleckSystemThrown，否则 data.velocity 不生效 -->
	<FleckDef>
		<defName>BlockSpark</defName>
		<fleckSystemClass>Verse.FleckSystemThrown</fleckSystemClass>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<graphicData>
			<graphicClass>Graphic_Fleck</graphicClass>
			<texPath>Familia_Myth/Things/Mote/ChargeSpark</texPath>
			<shaderType>MoteGlow</shaderType>
			<color>(1, 1, 1, 1)</color>
			<drawSize>(0.2, 0.2)</drawSize>
		</graphicData>
		<fadeInTime>0.05</fadeInTime>
		<solidTime>0.05</solidTime>
		<fadeOutTime>0.4</fadeOutTime>
	</FleckDef>

</Defs>