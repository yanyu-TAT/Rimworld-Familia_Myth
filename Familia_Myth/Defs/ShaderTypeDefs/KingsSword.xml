<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 君王之剑边缘辉光着色器：
       本模组采用自定义着色器，需将 .shader 打包进 asset bundle。
       打包时 bundle 内路径签约为 Assets/Data/Familia_Myth/Materials/KingsSword.shader，
       运行时 ContentFinder<Shader>.TryFindAssetInModBundles("KingsSword") 加载。
       若未打包(仅放置 .shader 文件)将无法加载，会回退到默认着色器（功能不受影响，仅辉光失效）。 -->
  <ShaderTypeDef>
    <defName>KingsSword</defName>
    <shaderPath>KingsSword</shaderPath>
  </ShaderTypeDef>
</Defs>