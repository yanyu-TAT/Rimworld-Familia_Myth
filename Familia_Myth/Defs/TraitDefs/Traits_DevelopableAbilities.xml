      <li>
        <label>魔导I</label>
        <degree>0</degree>
        <description>[PAWN_nameDef]拥有基础魔导能力。</description>
      </li>
      <li>
        <label>魔导H</label>
        <degree>1</degree>
        <description>[PAWN_nameDef]的魔导能力有所提升。</description>
      </li>
      <li>
        <label>魔导G</label>
        <degree>2</degree>
        <description>[PAWN_nameDef]的魔导能力稳步提升。</description>
      </li>
      <li>
        <label>魔导F</label>
        <degree>3</degree>
        <description>[PAWN_nameDef]的魔导能力显著提升。</description>
      </li>
      <li>
        <label>魔导E</label>
