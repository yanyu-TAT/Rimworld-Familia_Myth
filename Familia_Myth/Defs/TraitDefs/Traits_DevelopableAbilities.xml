      <li>
        <label>魔导D</label>
        <degree>5</degree>
        <description>[PAWN_nameDef]的魔导能力达到精进水平。</description>
      </li>
      <li>
        <label>魔导C</label>
        <degree>6</degree>
        <description>[PAWN_nameDef]的魔导能力达到高阶水平。</description>
      </li>
      <li>
        <label>魔导B</label>
        <degree>7</degree>
        <description>[PAWN_nameDef]的魔导能力达到卓越水平。</description>
      </li>
      <li>
        <label>魔导A</label>
        <degree>8</degree>
        <description>[PAWN_nameDef]的魔导能力达到顶尖水平。</description>
      </li>
      <li>
        <label>魔导S</label>
        <degree>9</degree>
        <description>[PAWN_nameDef]的魔导能力超凡脱俗。</description>
      </li>
      <li>
        <label>魔导SS</label>
        <degree>10</degree>
        <description>[PAWN_nameDef]的魔导能力达到传说级别。</description>
      </li>
      <li>
        <label>魔导SSS</label>
        <degree>11</degree>
        <description>[PAWN_nameDef]的魔导能力已臻化境。</description>
      </li>
    </degreeDatas>
  </TraitDef>

