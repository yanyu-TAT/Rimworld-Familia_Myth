<Defs>

  <!-- 魔导发展能力特性 -->
  <TraitDef>
    <defName>Trait_DevelopableAbility_Magic</defName>
    <label>魔导</label>
    <description>由恩惠赋予的魔导发展能力，提升心灵熵消散速度。</description>
    <commonality>0</commonality>
    <!-- 设为0防止随机生成，仅由恩惠赋予 -->
