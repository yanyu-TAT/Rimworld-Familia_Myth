<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 基础魔导发展能力：提升心灵熵恢复速率与上限 -->
  <!-- 由于原版不存在PsyfocusMax StatDef，我们通过提升心灵熵上限来实现类似精神力存储扩充的效果 -->
  <FamiliaMyth.Abilities.DevelopableAbilityDef>
    <defName>DevelopableAbility_Magic</defName>
    <label>魔导</label>
    <description>提升心灵熵消散速度与心灵熵上限的发展能力。通过冥想和灵能使用提升熟练度。</description>
    <abilityClass>FamiliaMyth.Abilities.DevelopableAbility_Magic</abilityClass>
    <maxProficiency>999</maxProficiency>
    <rarity>Uncommon</rarity>
    <traitDefName>Trait_DevelopableAbility_Magic</traitDefName>
  </FamiliaMyth.Abilities.DevelopableAbilityDef>

  <!-- 异常抗性发展能力：提升免疫速度与毒素抗性 -->
  <FamiliaMyth.Abilities.DevelopableAbilityDef>
    <defName>DevelopableAbility_AbnormalResistance</defName>
    <label>异常抗性</label>
    <description>提升免疫获得速度，毒素抗性以及抵抗疾病概率的发展能力。在恶劣环境中生存或抵抗疾病时提升熟练度。</description>
    <abilityClass>FamiliaMyth.Abilities.DevelopableAbility_AbnormalResistance</abilityClass>
    <maxProficiency>999</maxProficiency>
    <rarity>Common</rarity>
    <traitDefName>Trait_DevelopableAbility_AbnormalResistance</traitDefName>
  </FamiliaMyth.Abilities.DevelopableAbilityDef>

  <!-- 高效循环发展能力：休息值高时降低营养消耗，摄入营养时回复休息值 -->
  <FamiliaMyth.Abilities.DevelopableAbilityDef>
    <defName>DevelopableAbility_EfficientCirculation</defName>
    <label>高效循环</label>
    <description>提升身体能量循环效率的发展能力。休息充足时降低营养消耗，进食时按比例回复休息值。</description>
    <abilityClass>FamiliaMyth.Abilities.DevelopableAbility_EfficientCirculation</abilityClass>
    <maxProficiency>999</maxProficiency>
    <rarity>Common</rarity>
    <traitDefName>Trait_DevelopableAbility_EfficientCirculation</traitDefName>
  </FamiliaMyth.Abilities.DevelopableAbilityDef>

  <!-- 治愈发展能力：提升治疗与手术相关能力 -->
  <FamiliaMyth.Abilities.DevelopableAbilityDef>
    <defName>DevelopableAbility_Healing</defName>
    <label>治愈</label>
    <description>提升治疗品质、医疗/手术速度以及手术成功率的发展能力。通过治疗伤员、进行手术提升熟练度。</description>
    <abilityClass>FamiliaMyth.Abilities.DevelopableAbility_Healing</abilityClass>
    <maxProficiency>999</maxProficiency>
    <rarity>Common</rarity>
    <traitDefName>Trait_DevelopableAbility_Healing</traitDefName>
  </FamiliaMyth.Abilities.DevelopableAbilityDef>

  <!-- 海之眷顾发展能力：提升钓鱼速度与产出数量，并有概率额外钓获稀有物品 -->
  <FamiliaMyth.Abilities.DevelopableAbilityDef>
    <defName>DevelopableAbility_LuckOfTheSea</defName>
    <label>海之眷顾</label>
    <description>提升钓鱼速度与产出数量，并有概率在钓鱼时额外获得稀有渔获的发展能力。通过钓鱼提升熟练度。</description>
    <abilityClass>FamiliaMyth.Abilities.DevelopableAbility_LuckOfTheSea</abilityClass>
    <maxProficiency>999</maxProficiency>
    <rarity>Uncommon</rarity>
    <traitDefName>Trait_DevelopableAbility_LuckOfTheSea</traitDefName>
  </FamiliaMyth.Abilities.DevelopableAbilityDef>

  <!-- 植生学发展能力：提升种植相关能力 -->
  <FamiliaMyth.Abilities.DevelopableAbilityDef>
    <defName>DevelopableAbility_Botany</defName>
    <label>植生学</label>
    <description>提升播种/收获速度、收获效率以及野外采集效率的发展能力。通过植物类工作提升熟练度。</description>
    <abilityClass>FamiliaMyth.Abilities.DevelopableAbility_Botany</abilityClass>
    <maxProficiency>999</maxProficiency>
    <rarity>Common</rarity>
    <traitDefName>Trait_DevelopableAbility_Botany</traitDefName>
  </FamiliaMyth.Abilities.DevelopableAbilityDef>

  <!-- 矿物学发展能力：提升采矿相关能力 -->
  <FamiliaMyth.Abilities.DevelopableAbilityDef>
    <defName>DevelopableAbility_Mineralogy</defName>
    <label>矿物学</label>
    <description>提升采矿/深钻井操作速度以及采矿效率的发展能力。通过采矿类工作提升熟练度。</description>
    <abilityClass>FamiliaMyth.Abilities.DevelopableAbility_Mineralogy</abilityClass>
    <maxProficiency>999</maxProficiency>
    <rarity>Common</rarity>
    <traitDefName>Trait_DevelopableAbility_Mineralogy</traitDefName>
  </FamiliaMyth.Abilities.DevelopableAbilityDef>

  <!-- 武器同调发展能力：近战命中率、武器熟练度与暴击 -->
  <FamiliaMyth.Abilities.DevelopableAbilityDef>
    <defName>DevelopableAbility_WeaponAttunement</defName>
    <label>武器同调</label>
    <description>提升近战命中率，并通过装备近战武器积累武器熟练度的发展能力。武器熟练度提供概率重置攻击冷却与暴击概率。通过近战战斗提升熟练度。</description>
    <abilityClass>FamiliaMyth.Abilities.DevelopableAbility_WeaponAttunement</abilityClass>
    <maxProficiency>999</maxProficiency>
    <rarity>Rare</rarity>
    <traitDefName>Trait_DevelopableAbility_WeaponAttunement</traitDefName>
  </FamiliaMyth.Abilities.DevelopableAbilityDef>

  <!-- 连攻发展能力：按近战出手频率提供力量/灵巧补正 -->
  <FamiliaMyth.Abilities.DevelopableAbilityDef>
    <defName>DevelopableAbility_ChainAttack</defName>
    <label>连攻</label>
    <description>战斗中随近战攻击频率提升力量与灵巧的发展能力。持续近战出手时补正上升，停止攻击后逐渐消退。通过近战战斗提升熟练度。</description>
    <abilityClass>FamiliaMyth.Abilities.DevelopableAbility_ChainAttack</abilityClass>
    <maxProficiency>999</maxProficiency>
    <rarity>Rare</rarity>
    <traitDefName>Trait_DevelopableAbility_ChainAttack</traitDefName>
  </FamiliaMyth.Abilities.DevelopableAbilityDef>

  <!-- 精愈发展能力：持续自动恢复精神力 -->
  <FamiliaMyth.Abilities.DevelopableAbilityDef>
    <defName>DevelopableAbility_MindHealing</defName>
    <label>精愈</label>
    <description>持续自动恢复精神力的发展能力。精神力越满恢复越慢，并随熟练度提高而加快。通过消耗精神力提升熟练度。</description>
    <abilityClass>FamiliaMyth.Abilities.DevelopableAbility_MindHealing</abilityClass>
    <maxProficiency>999</maxProficiency>
    <rarity>Uncommon</rarity>
    <traitDefName>Trait_DevelopableAbility_MindHealing</traitDefName>
  </FamiliaMyth.Abilities.DevelopableAbilityDef>

</Defs>