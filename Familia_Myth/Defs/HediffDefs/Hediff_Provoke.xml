<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>ProvokeInEffect</defName>
    <label>吸引仇恨</label>
    <description>正在吸引周围敌人的仇恨，使其攻击目标变为自己。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="FamiliaMyth.Abilities.HediffCompProperties_SkillInEffect">
        <skillDef>Skill_Provoke</skillDef>
		<compClass>FamiliaMyth.Abilities.HediffComp_SkillInEffect</compClass>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>7200</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <!-- 效果挂在自己身上、作用于敌人，故 allowSelf -->
      <li Class="FamiliaMyth.Abilities.HediffCompProperties_FeatSupport">
        <supportPerSecond>1.0</supportPerSecond>
        <allowSelf>true</allowSelf>
      </li>
    </comps>
  </HediffDef>

</Defs>
