<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>EmberInEffect</defName>
    <label>余烬</label>
    <description>濒死时触发的求生本能。持续期间快速修复伤势。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li>
        <compClass>FamiliaMyth.Abilities.HediffComp_EmberInEffect</compClass>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>EmberState</defName>
    <label>余烬状态</label>
    <description>用于显示余烬技能当前状态。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <minSeverity>0.0</minSeverity>
        <label>可适用</label>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>生效中</label>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>冷却中</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>EmberAftereffect</defName>
    <label>余烬反噬</label>
    <description>余烬结束后的后遗症，会陷入短暂昏迷。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
