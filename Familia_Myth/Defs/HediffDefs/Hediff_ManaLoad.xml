<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>ManaLoadInEffect</defName>
    <label>魔力装填</label>
    <description>消耗的魔力转化为属性增益，期间再次消耗魔力会重置持续时间。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="FamiliaMyth.Abilities.HediffCompProperties_SkillInEffect">
        <skillDef>Skill_ManaLoad</skillDef>
        <compClass>FamiliaMyth.Abilities.HediffComp_ManaLoadInEffect</compClass>
      </li>
      <!-- 与 HediffComp_ManaLoadInEffect.EffectDurationTicks（2 小时）保持一致 -->
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>5000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

</Defs>
