<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- 眷族信仰的文化命名规则包：全部规则以 priority=1 压制原版命名规则，成品名直接写在此处 -->
	<!-- 神灵的名字与称号不在此处：由 MemeDef.fixedDeityNameTypes 成对提供 -->
	<RulePackDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>NamerFamiliaMyth</defName>
		<rulePack>
			<rulesStrings>
				<!-- ==================== 文化名（r_ideoName） ==================== -->
				<!-- [keyDeity] 为运行时注入的主神名；保持至少一条不依赖它的规则以便兜底 -->
				<li>r_ideoName(priority=1)->[keyDeity]眷族</li>
				<li>r_ideoName(priority=0)->眷族</li>

				<!-- ==================== 文化形容词 / 成员名（r_ideoAdjective / r_memberName） ==================== -->
				<li>r_ideoAdjective(priority=1)->眷族</li>
				<li>r_memberName(priority=1)->眷族成员</li>

				<!-- ==================== 领袖头衔（r_leaderTitle） ==================== -->
				<li>r_leaderTitle(priority=1)->团长</li>

				<!-- ==================== 道德家角色名（r_roleName） ==================== -->
				<li>r_roleName(priority=1)->副团长</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>
</Defs>
