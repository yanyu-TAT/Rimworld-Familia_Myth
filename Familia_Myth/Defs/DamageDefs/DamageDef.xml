<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ==================== 光箭伤害  ===================== -->
	<DamageDef>
		<defName>LightArrow</defName>
		<label>光箭</label>

		<!-- 无视承伤系数：覆写 DamageWorker 预放大抵消 IncomingDamageFactor -->
		<workerClass>FamiliaMyth.Abilities.DamageWorker_NoDamageFactor</workerClass>
		<externalViolence>true</externalViolence>

		<deathMessage>{0} has been pierced to death.</deathMessage>
		<hediff>Stab</hediff>
		<hediffSkin>Cut</hediffSkin>
		<hediffSolid>Crack</hediffSolid>
		<harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
		<impactSoundType>Bullet</impactSoundType>
		<armorCategory>Sharp</armorCategory>
		<overkillPctToDestroyPart>0.5~0.8</overkillPctToDestroyPart>
		<isRanged>true</isRanged>
		<makesAnimalsFlee>true</makesAnimalsFlee>

		<modExtensions>
			<li Class="FamiliaMyth.Abilities.DamageFactorIgnore_Extension">
				<ignoreFactor>1</ignoreFactor>
			</li>
		</modExtensions>
	</DamageDef>

	<!-- ==================== 大爆炸  ===================== -->
	<!-- 继承原版 Vaporize（热能蒸发爆炸），覆盖爆炸色调为红→紫，并重写伤害 Worker 移除中心 2.9 格直接伤害限制 -->
	<DamageDef ParentName="Vaporize">
		<defName>SpellExplosion</defName>
		<label>爆裂魔法</label>
		<workerClass>FamiliaMyth.Abilities.DamageWorker_SpellExplosion</workerClass>
		<deathMessage>{0} 被爆裂魔法蒸发殆尽。</deathMessage>
		<explosionColorCenter>(1, 0.35, 0.2)</explosionColorCenter>
		<explosionColorEdge>(0.62, 0.2, 0.9)</explosionColorEdge>
	</DamageDef>

</Defs>