<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 探索类 · 日常任务（据点清剿） -->
  <!-- 由 IncidentWorker_GuildEnvoy 随机挑选，交给使者载体 -->
  <!-- 玩家可见文本可经 Languages/<语言>/DefInjected/GuildQuestDef/GuildQuests.xml 覆盖（此处为默认文本，同时作为兜底） -->
  <FamiliaMyth.Quest.GuildQuestDef>
    <defName>GuildQuest_Daily_SiteClearance</defName>
    <label>据点清剿</label>
    <generatorClass>FamiliaMyth.Quest.GuildQuestGenerator_Daily_SiteClearance</generatorClass>
    <category>Explorer</category>
    <type>Daily</type>
    <letterText>使者向你介绍了剿灭委托的详情。\n\n公会在附近发现了一处邪恶派阀据点，\n放任不管会严重危害周边治安。现请求派出冒险者前去肃清。\n\n是否接受？</letterText>
  </FamiliaMyth.Quest.GuildQuestDef>

  <!-- 探索类 · （强制任务）据点清剿 -->
  <!-- 达到升级点数后由 GameComponent_FamiliaRankTracker 触发，不可拒绝 -->
  <FamiliaMyth.Quest.GuildQuestDef>
    <defName>GuildQuest_RankUp_SiteClearance</defName>
    <label>据点清剿</label>
    <generatorClass>FamiliaMyth.Quest.GuildQuestGenerator_RankUP_SiteClearance</generatorClass>
    <category>Explorer</category>
    <type>RankUp</type>
    <letterText>使者向你介绍了强制任务的详情，并提醒你做好准备。\n\n公会在附近发现了一处邪恶派阀据点，\n放任不管会严重危害周边治安。现请求派出冒险者前去肃清。</letterText>
  </FamiliaMyth.Quest.GuildQuestDef>

</Defs>
