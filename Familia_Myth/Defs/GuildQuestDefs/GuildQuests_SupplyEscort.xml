<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 探索类 · （强制任务）物资押运 -->
  <!-- 达到升级点数后由 GameComponent_FamiliaRankTracker 触发，不可拒绝 -->
  <!-- Available() 预筛：世界层凑不出合格 A/B 定居点组合时不发布 -->
  <!-- 玩家可见文本可经 Languages/<语言>/DefInjected/GuildQuestDef/GuildQuests.xml 覆盖（此处为默认文本，同时作为兜底） -->
  <FamiliaMyth.Quest.GuildQuestDef>
    <defName>GuildQuest_RankUp_SupplyEscort</defName>
    <label>物资押运</label>
    <generatorClass>FamiliaMyth.Quest.GuildQuestGenerator_RankUp_SupplyEscort</generatorClass>
    <category>Explorer</category>
    <type>RankUp</type>
    <letterText>使者向你介绍了强制任务的详情，并提醒你做好准备。\n\n公会有一批物资需要从一处定居点押运至另一处，\n限 12 天内完成交付，途中可能有劫匪。\n\n该任务不可拒绝，请派出可靠的远行队。\n完成任务即可提升眷族在「探索类」方面的评级。</letterText>
  </FamiliaMyth.Quest.GuildQuestDef>

</Defs>
