<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 强制升级考核任务脚本 -->
  <!-- 由 GuildQuestGenerator_RankUP_SiteClearance.QuestScriptDefName 引用 -->
  <!-- 流程：达标 → 使者出场（自动接取）→ 生成强化站点 → 清剿 → 晋升评级 + 伟业值 -->
  <!-- 失败/超时 → QuestNode_RankUpFailed 通知 tracker → 1~5 天后自动重发 -->
  <QuestScriptDef>
    <defName>Quest_RankUp_SiteClearance</defName>
    <autoAccept>true</autoAccept>
    <defaultHidden>false</defaultHidden>
    <isRootSpecial>true</isRootSpecial>
    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>200</rootMinPoints>
    <affectedByPopulation>false</affectedByPopulation>

    <questNameRules>
      <rulesStrings>
        <li>questName->强制任务</li>
        <li>missionTitle->公会</li>
      </rulesStrings>
    </questNameRules>

    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->公会使者带来了强制任务。敌人已在附近集结，正在威胁着周边地区。请倾全部战力，证明眷族的实力。\n\n完成任务即可提升眷族评级，并获得大量伟业值。</li>
      </rulesStrings>
    </questDescriptionRules>

    <root Class="QuestNode_Sequence">
      <nodes>

        <!-- 考核根节点：读取 $category、计算难度、生成站点参数 -->
        <li Class="FamiliaMyth.Quest.QuestNode_Root_RankUp_SiteClearance">
          <category>$category</category>
        </li>

        <li Class="QuestNode_Sequence">
          <nodes>

            <!-- 获取目标地点tile -->
            <li Class="QuestNode_GetSiteTile">
              <storeAs>siteTile</storeAs>
              <preferCloserTiles>true</preferCloserTiles>
            </li>

            <!-- 生成强制考核站点 -->
            <li Class="QuestNode_SubScript">
              <def>Util_GenerateSite</def>
            </li>

            <!-- 将站点添加到世界地图 -->
            <li Class="QuestNode_SpawnWorldObjects">
              <worldObjects>$site</worldObjects>
            </li>

            <!-- 清剿所有敌人后完成考核：晋升评级 + 发放伟业值（奖励部件均监听 rewardsReady） -->
            <li Class="QuestNode_Signal">
              <inSignal>site.AllEnemiesDefeated</inSignal>
              <node Class="QuestNode_Sequence">
                <nodes>
                  <!-- 晋升眷族评级 -->
                  <li Class="FamiliaMyth.Quest.QuestNode_RankUpComplete">
                    <categoryDef>$category</categoryDef>
                  </li>
                  <!-- 发放伟业值（威胁清除时点按站点在场人员快照；无接取者 → 全员均分） -->
                  <li Class="FamiliaMyth.Quest.QuestNode_SiteClearanceReward">
                    <site>$site</site>
                    <totalExploits>$totalExploits</totalExploits>
                    <letterLabel TKey="LetterLabelRankUpCompleted">强制任务完成</letterLabel>
                    <category>$category</category>
                    <upgradePoints>10</upgradePoints>
                  </li>
                  <!-- 触发奖励结算 -->
                  <li Class="QuestNode_SendSignals">
                    <outSignals>
                      <li>rewardsReady</li>
                    </outSignals>
                  </li>
                  <!-- 任务成功结束 -->
                  <li Class="QuestNode_End">
                    <outcome>Success</outcome>
                  </li>
                </nodes>
              </node>
            </li>

            <!-- 超时失败 -->
            <li Class="QuestNode_WorldObjectTimeout">
              <worldObject>$site</worldObject>
              <delayTicksRange>720000~1680000</delayTicksRange>
              <destroyOnCleanup>true</destroyOnCleanup>
              <node Class="QuestNode_Sequence">
                <nodes>
                  <li Class="QuestNode_Letter">
                    <label TKey="LetterLabelRankUpFailed">强制任务失败</label>
                    <text TKey="LetterTextRankUpFailed">强制任务[resolvedQuestName]已超时，眷族晋升暂时搁置。数日后公会使者将再次前来发布考核任务。</text>
                  </li>
                  <!-- 通知 tracker 记录失败，进入 1~5 天冷却后自动重发 -->
                  <li Class="FamiliaMyth.Quest.QuestNode_RankUpFailed">
                    <categoryDef>$category</categoryDef>
                  </li>
                  <li Class="QuestNode_End">
                    <outcome>Fail</outcome>
                  </li>
                </nodes>
              </node>
            </li>

          </nodes>
        </li>

      </nodes>
    </root>
  </QuestScriptDef>

</Defs>