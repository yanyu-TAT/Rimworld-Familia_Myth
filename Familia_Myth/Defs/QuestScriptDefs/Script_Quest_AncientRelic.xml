<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 日常任务「遗迹探索」脚本 -->
  <!-- 流程：接取 → 生成原版 AncientComplex 遗迹(2~10 格, 12 天超时表) -->
  <!--       → 进图后任务机关箱落位于室内(内含圣物匣) → 玩家开箱 = 发现 -->
  <!--       → 1~3 天 0.5× 袭击打据点 / 3~5 天公会穿梭机到据点(停 2 天, 圣物上船即飞) -->
  <!--       → SentSatisfied → 交付完成；窗口满未装/圣物被毁或失踪 → 失败 -->
  <QuestScriptDef>
    <defName>Quest_AncientRelic</defName>
    <autoAccept>true</autoAccept>
    <defaultHidden>false</defaultHidden>
    <isRootSpecial>true</isRootSpecial>
    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>200</rootMinPoints>
    <affectedByPopulation>false</affectedByPopulation>

    <questNameRules>
      <rulesStrings>
        <li>questName->遗迹探索</li>
      </rulesStrings>
    </questNameRules>

    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->公会收到消息：殖民地附近的远古遗迹中沉睡着一件失落文明的圣物匣。\n\n前往标记的遗迹，找到并开启其中的机关箱，取回圣物匣并带回据点。\n\n圣物匣被发现后约 1~3 天会有敌袭扑向据点，约 3~5 天内公会的穿梭机将抵达接应——请在此之前把它带回据点，装上穿梭机即可完成委托。\n\n注意：圣物匣若被摧毁或落入他人之手，委托将失败。</li>
      </rulesStrings>
    </questDescriptionRules>

    <root Class="QuestNode_Sequence">
      <nodes>

        <!-- 根节点：计算点数、生成 AncientComplex 遗迹并装配参数 -->
        <li Class="FamiliaMyth.Quest.QuestNode_Root_Daily_AncientRelic" />

        <!-- 遗迹 12 天时限（开箱发现 = 停表；超时任务失败） -->
        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <delayTicksRange>720000~720000</delayTicksRange>
          <destroyOnCleanup>true</destroyOnCleanup>
          <inSignalDisable>relicCrateOpened</inSignalDisable>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelRelicFailed">遗迹探索失败</label>
                <text TKey="LetterTextRelicTimeout">任务[resolvedQuestName]超时：圣物匣未能被及时寻获，遗迹线索已经断绝。任务失败。</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <!-- 发现后 3~5 天到点（relicShuttleCall）：公会穿梭机降落玩家据点 -->
        <!-- 2 天窗口；圣物匣(required)上船即飞；全员消失则直接离开 -->
        <li Class="QuestNode_Signal">
          <inSignal>relicShuttleCall</inSignal>
          <node Class="QuestNode_SubScript">
            <def>Util_TransportShip_Pickup</def>
            <parms>
              <requiredItems>$requiredItems</requiredItems>
              <owningFaction>$guildFaction</owningFaction>
              <leaveDelayTicks>120000</leaveDelayTicks>
              <leaveImmediatelyWhenSatisfied>true</leaveImmediatelyWhenSatisfied>
            </parms>
          </node>
        </li>

        <!-- 穿梭机落地 → 通知玩家装货 -->
        <li Class="QuestNode_Signal">
          <inSignal>pickupShipThing.Spawned</inSignal>
          <node Class="QuestNode_Letter">
            <label TKey="LetterLabelShuttleArrived">公会穿梭机已抵达</label>
            <text TKey="LetterTextShuttleArrived">公会的穿梭机已降落在据点，前来接收圣物匣。\n\n请将圣物匣装入穿梭机——圣物匣上船后穿梭机将立刻起飞，委托完成。\n\n穿梭机将在 2 天后自行起飞：届时圣物匣未装船则委托失败。</text>
          </node>
        </li>

        <!-- 装配部件（在 util 之后，读取 pickupShipThing） -->
        <li Class="FamiliaMyth.Quest.QuestNode_AncientRelicSetup" />

      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
