<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- =============================================================== -->
  <!-- 美德心情 Thought 定义                                            -->
  <!-- 由 HediffComp_ThoughtSetter 在添加美德 Buff 时写入、移除时清除。   -->
  <!-- HediffComp_ThoughtSetter 会将其 moodOffset 值覆盖到记忆上，        -->
  <!-- 因此 baseMoodEffect 与之保持一致（+15）。                         -->
  <!-- =============================================================== -->

  <ThoughtDef>
    <defName>Thought_Virtue_Vigorous_Morale</defName>
    <!-- HediffComp_ThoughtSetter 要求记忆类 Thought（会 cast 为 Thought_Memory），
         必须显式指定 thoughtClass，否则默认按 Thought_Situational 实例化导致强制转换失败 -->
    <thoughtClass>Thought_Memory</thoughtClass>
    <label>美德：振奋</label>
    <stages>
      <li>
        <label>振奋</label>
        <description>同伴的振奋让我也感到精神振奋</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- 触发者本人的振奋：与同伴获得的 Morale 分开，
       叙事上「自己重新振作」而非「被身边人感染」 -->
  <ThoughtDef>
    <defName>Thought_Virtue_Vigorous_Self</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <label>美德：振奋</label>
    <stages>
      <li>
        <label>振奋</label>
        <description>我还能站起来，而且我并不孤单</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>