<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Debug;Release;111</Configurations>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- mod 目录只应出现本模组 DLL，禁止生成 .deps.json 等宿主文件 -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- 两个目标框架的中间目录必须隔离，否则并行构建会互相覆盖 GlobalUsings 等中间文件 -->
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <!-- 两个目标框架串行构建：并行调度会互相干扰，整项目构建时报“生成失败”且不报错误 -->
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <!-- RimWorld 1.6（Mono / .NET Framework 4.7.2） -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net472'">
    <BaseOutputPath>$(MSBuildThisFileDirectory)1.6\Assemblies</BaseOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)1.6\Assemblies</OutputPath>
    <DefineConstants>$(DefineConstants);RW16</DefineConstants>
  </PropertyGroup>

  <!-- RimWorld 1.7（CoreCLR / .NET 10） -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0'">
    <BaseOutputPath>$(MSBuildThisFileDirectory)1.7\Assemblies</BaseOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)1.7\Assemblies</OutputPath>
    <DefineConstants>$(DefineConstants);RW17</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="1.7\**" />
    <Compile Remove="Texture\**" />
    <Compile Remove="Defs\**" />
    <EmbeddedResource Remove="1.7\**" />
    <EmbeddedResource Remove="Texture\**" />
    <None Remove="1.7\**" />
    <None Remove="Texture\**" />
  </ItemGroup>

  <!-- 1.6 引用副本：lib\1.6（来源见 13-同步引用库.ps1） -->
  <ItemGroup Condition="'$(TargetFramework)'=='net472'">
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Assembly-CSharp">
      <HintPath>..\lib\1.6\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\lib\1.6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\lib\1.6\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\lib\1.6\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>..\lib\1.6\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\lib\1.6\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\lib\1.6\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\lib\1.6\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>..\lib\1.6\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\lib\1.6\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>..\lib\1.6\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime" />
    <!-- 必须用 Mono 的 mscorlib 覆盖 targeting pack 版本：Unity Mono 支持默认接口实现，编译器据此放行 -->
    <Reference Include="mscorlib">
      <HintPath>..\lib\1.6\mscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 1.7 引用副本：lib\1.7（来源见 13-同步引用库.ps1） -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <Reference Include="Assembly-CSharp">
      <HintPath>..\lib\1.7\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\lib\1.7\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>..\lib\1.7\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityStubs 的 Unity 类型实际定义在 Waylith 运行时程序集，缺它会出现 CS0012 -->
    <Reference Include="Waylith">
      <HintPath>..\lib\1.7\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
